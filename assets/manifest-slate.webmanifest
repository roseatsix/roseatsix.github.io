{
  "name": "rose at six",
  "short_name": "rose at six",
  "description": "A small garden of everyday tools.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F3F4F6",
  "theme_color": "#F3F4F6",
  "icons": [
    {
      "src": "/assets/icons/slate-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/icons/slate-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/assets/icons/slate-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/",
  "share_target": {
    "action": "/tools/inbox/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "photos",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
